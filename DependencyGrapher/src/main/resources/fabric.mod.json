{
	"schemaVersion": 1,
	"id": "dependencygrapher",
	"version": "${version}",
	"name": "DependencyGrapher",
	"description": "Generates a json dependency graph of all loaded mods.",
	"authors": [
		"object-Object"
	],
	"contact": {
		"homepage": "https://github.com/object-Object/modlist-bisector",
		"sources": "https://github.com/object-Object/modlist-bisector"
	},
	"license": "MIT",
	"icon": "assets/dependencygrapher/icon.png",
	"environment": "*",
	"entrypoints": {
		"preLaunch": [
			{
				"value": "gay.object.dependencygrapher.DependencyGrapherPreLaunch",
				"adapter": "kotlin"
			}
		]
	},
	"depends": {
		"fabricloader": ">=0.16.9",
		"java": ">=17",
		"fabric-language-kotlin": "*"
	},
	"breaks": {
		"quilt_loader": "<0.28.1"
	}
}
